<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acceso directo a archivos sensibles (.env, composer, git)
    RewriteRule ^(\.env|composer\.(json|lock)|package\.json|artisan) - [F,L,NC]

    # Evitar reescritura duplicada si ya apunta a public/
    RewriteCond %{REQUEST_URI} !/sistema_test/public/ [NC]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>